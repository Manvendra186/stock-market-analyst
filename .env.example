# ─── Telegram Bot Token ───
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ─── Your Telegram User ID ───
# Get this by messaging @userinfobot on Telegram
ALLOWED_USER_ID=your_numeric_user_id_here

# ─── LM Studio Local LLM ───
# Default port for LM Studio is 1234
LLM_BASE_URL=http://localhost:1234

# Model name — adjust to match what you loaded in LM Studio
# Check LM Studio's model list to find the exact name
LLM_MODEL=qwen3-27b

# Max tokens for response (NYX gives detailed analysis)
LLM_MAX_TOKENS=8192

# Temperature (0.3 = focused/analytical, 0.7 = more creative)
LLM_TEMPERATURE=0.3
